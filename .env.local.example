# From api-console.zoho.com -> Self Client
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=

# Filled in by `npm run exchange-code` after you generate a code in the Zoho API Console
ZOHO_REFRESH_TOKEN=

# Optional default organization. Leave empty to make every request name its organization (recommended
# when the account can see many clients). Run list_organizations to see the available ids.
ZOHO_ORG_ID=

# Optional: restrict the connector to these organization ids (comma-separated). Empty = every organization
# the Zoho account can reach.
ZOHO_ALLOWED_ORG_IDS=

# Must match the data center your Books org actually lives on.
# Options: accounts.zoho.com / accounts.zoho.in / accounts.zoho.eu / accounts.zoho.com.au
ZOHO_ACCOUNTS_DOMAIN=accounts.zoho.com

# Matching API domain for the same data center.
# Options: www.zohoapis.com / www.zohoapis.in / www.zohoapis.eu / www.zohoapis.com.au
ZOHO_API_DOMAIN=www.zohoapis.com

# Hosted per-user sign-in (Render). Create a "Server-based Application" in api-console.zoho.com with
# redirect URI  <PUBLIC_URL>/oauth/zoho/callback . Setting ZOHO_OAUTH_CLIENT_ID turns OAuth mode on.
ZOHO_OAUTH_CLIENT_ID=
ZOHO_OAUTH_CLIENT_SECRET=
# Optional: defaults to RENDER_EXTERNAL_URL on Render.
PUBLIC_URL=
